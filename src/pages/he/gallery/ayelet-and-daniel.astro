---
import Layout from '../../../layouts/Layout.astro';
import { galleryTemplate } from '../../../data/site.he';

const storyPhotos = ['/images/photos/frieda-simeon-2.webp', '/images/photos/frieda-simeon-6.webp', '/images/photos/frieda-simeon-9.webp'];

const galleryPhotos = [
  '/images/gallery/ayelet-and-daniel/photo-01.webp',
  '/images/gallery/ayelet-and-daniel/photo-02.webp',
  '/images/gallery/ayelet-and-daniel/photo-03.webp',
  '/images/gallery/ayelet-and-daniel/photo-04.webp',
  '/images/gallery/ayelet-and-daniel/photo-05.webp',
  '/images/gallery/ayelet-and-daniel/photo-06.webp',
  '/images/gallery/ayelet-and-daniel/photo-07.webp',
  '/images/gallery/ayelet-and-daniel/photo-08.webp',
  '/images/gallery/ayelet-and-daniel/photo-09.webp',
  '/images/gallery/ayelet-and-daniel/photo-10.webp',
  '/images/gallery/ayelet-and-daniel/photo-11.webp',
  '/images/gallery/ayelet-and-daniel/photo-12.webp',
];
---
<Layout lang="he" dir="rtl" title={galleryTemplate.title} description={galleryTemplate.description} canonical={`https://bebke.co.il/he/gallery/${galleryTemplate.slug}/`}>
  <section class="relative text-white px-6 py-24 text-center overflow-hidden">
    <img src="/images/photos/frieda-simeon-10.webp" alt={galleryTemplate.heroH1} class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/55"></div>
    <div class="relative">
      <h1 class="text-4xl md:text-6xl font-black max-w-4xl mx-auto">{galleryTemplate.heroH1}</h1>
      <p class="mt-4 script text-2xl text-brand-yellow">{galleryTemplate.heroSub}</p>
    </div>
  </section>

  <section class="grid md:grid-cols-3">
    {galleryTemplate.storyColumns.map((col, i) => (
      <div class="relative min-h-[420px] flex flex-col justify-end p-8 text-white overflow-hidden">
        <img src={storyPhotos[i % storyPhotos.length]} alt={col.title} class="absolute inset-0 w-full h-full object-cover" />
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative">
          <h2 class="font-black text-2xl mb-3">{col.title}</h2>
          <p class="font-medium opacity-90">{col.body}</p>
        </div>
      </div>
    ))}
  </section>

  <section class="bg-brand-mint py-20 px-6 text-center">
    <blockquote class="max-w-2xl mx-auto text-xl md:text-2xl font-medium italic">"{galleryTemplate.testimonial.quote}"</blockquote>
    <p class="mt-6 script text-2xl">{galleryTemplate.testimonial.author}</p>
  </section>

  <section class="bg-white py-16 px-4 md:px-6">
    <div class="columns-2 md:columns-4 gap-4 max-w-7xl mx-auto [column-fill:_balance]">
      {galleryPhotos.map((src, i) => (
        <div class="mb-4 break-inside-avoid overflow-hidden rounded-sm group">
          <img src={src} alt={`${galleryTemplate.heroSub} — תמונה ${i + 1}`} loading="lazy" class="w-full h-auto object-cover group-hover:scale-105 transition-transform duration-500" />
        </div>
      ))}
    </div>
  </section>

  <section class="bg-brand-red text-black py-16 px-6 text-center">
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/he/gallery/" class="bg-white text-black border-2 border-black px-8 py-3 font-bold rounded-full hover:bg-black hover:text-white transition-colors">{galleryTemplate.backToGallery}</a>
      <a href="/he/contact/" class="bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">{galleryTemplate.contactCta}</a>
    </div>
  </section>
</Layout>
