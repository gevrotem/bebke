---
import Layout from '../../../layouts/Layout.astro';
import { galleryTemplate } from '../../../data/site.he';

const colColors = ['bg-brand-green text-white', 'bg-brand-yellow text-black', 'bg-brand-sky text-black'];
---
<Layout lang="he" dir="rtl" title={galleryTemplate.title} description={galleryTemplate.description} canonical={`https://bebke.co.il/he/gallery/${galleryTemplate.slug}/`}>
  <section class="bg-black text-white px-6 py-20 text-center">
    <h1 class="text-4xl md:text-6xl font-black max-w-4xl mx-auto">{galleryTemplate.heroH1}</h1>
    <p class="mt-4 script text-2xl text-brand-yellow">{galleryTemplate.heroSub}</p>
  </section>

  <section class="grid md:grid-cols-3">
    {galleryTemplate.storyColumns.map((col, i) => (
      <div class:list={["p-8 min-h-[280px] flex flex-col justify-center", colColors[i % colColors.length]]}>
        <h2 class="font-black text-2xl mb-3">{col.title}</h2>
        <p class="font-medium opacity-90">{col.body}</p>
      </div>
    ))}
  </section>

  <section class="bg-brand-mint py-20 px-6 text-center">
    <blockquote class="max-w-2xl mx-auto text-xl md:text-2xl font-medium italic">"{galleryTemplate.testimonial.quote}"</blockquote>
    <p class="mt-6 script text-2xl">{galleryTemplate.testimonial.author}</p>
  </section>

  <section class="bg-brand-red text-black py-16 px-6 text-center">
    <div class="flex flex-wrap justify-center gap-4">
      <a href="/he/gallery/" class="bg-white text-black border-2 border-black px-8 py-3 font-bold rounded-full hover:bg-black hover:text-white transition-colors">{galleryTemplate.backToGallery}</a>
      <a href="/he/contact/" class="bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">{galleryTemplate.contactCta}</a>
    </div>
  </section>
</Layout>
