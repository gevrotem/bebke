---
import Layout from '../../../layouts/Layout.astro';
import { gallery } from '../../../data/site.he';

// Stable photo assignment per wedding slug (not per array position) so sorting
// never shuffles which photo belongs to which card.
const photoPool = ['/images/photos/frieda-simeon-1.webp', '/images/photos/mosaic-12-couple.webp', '/images/photos/frieda-simeon-4.webp', '/images/photos/mosaic-09-horse.webp', '/images/photos/frieda-simeon-7.webp', '/images/photos/stock-3.webp', '/images/photos/mosaic-05.webp', '/images/photos/frieda-simeon-10.webp', '/images/photos/frieda-simeon-2.webp'];
const photosBySlug = Object.fromEntries(gallery.weddings.map((w, i) => [w.slug, photoPool[i % photoPool.length]]));
const itemsJson = JSON.stringify(gallery.weddings.map(w => ({ ...w, photo: photosBySlug[w.slug] })));
---
<Layout lang="he" dir="rtl" title={gallery.title} description={gallery.description} canonical="https://bebke.co.il/he/gallery/">
  <section class="bg-brand-mint px-6 py-20 text-center">
    <h1 class="text-5xl md:text-7xl font-black">{gallery.heroH1}</h1>
    <p class="mt-4 max-w-2xl mx-auto text-lg font-medium">{gallery.heroSub}</p>

    <div class="mt-8 flex justify-center" x-data="{ open: false, sortBy: 'default', sortLabel: 'מיון לפי' }">
      <div class="relative">
        <button type="button" @click="open = !open" @click.outside="open = false" class="flex items-center gap-2 border-2 border-black rounded-full px-6 py-2 font-medium bg-white">
          <span x-text="sortLabel"></span>
          <span class="text-xs">▾</span>
        </button>
        <div x-show="open" x-cloak x-transition class="absolute right-1/2 translate-x-1/2 mt-2 w-52 bg-white border-2 border-black rounded-2xl overflow-hidden z-10 text-right">
          <button type="button" class="block w-full px-5 py-2 hover:bg-brand-mint" @click="sortBy = 'default'; sortLabel = 'מיון לפי'; open = false; window.dispatchEvent(new CustomEvent('gallery-sort', { detail: 'default' }))">נבחרים</button>
          <button type="button" class="block w-full px-5 py-2 hover:bg-brand-mint" @click="sortBy = 'guests-desc'; sortLabel = 'הכי הרבה אורחים'; open = false; window.dispatchEvent(new CustomEvent('gallery-sort', { detail: 'guests-desc' }))">הכי הרבה אורחים</button>
          <button type="button" class="block w-full px-5 py-2 hover:bg-brand-mint" @click="sortBy = 'guests-asc'; sortLabel = 'הכי מעט אורחים'; open = false; window.dispatchEvent(new CustomEvent('gallery-sort', { detail: 'guests-asc' }))">הכי מעט אורחים</button>
          <button type="button" class="block w-full px-5 py-2 hover:bg-brand-mint" @click="sortBy = 'az'; sortLabel = 'א – ת'; open = false; window.dispatchEvent(new CustomEvent('gallery-sort', { detail: 'az' }))">א – ת</button>
        </div>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16"
    x-data={`{
      items: ${itemsJson},
      init() {
        window.addEventListener('gallery-sort', (e) => {
          const sortBy = e.detail;
          if (sortBy === 'guests-desc') this.items = [...this.items].sort((a,b) => b.guests - a.guests);
          else if (sortBy === 'guests-asc') this.items = [...this.items].sort((a,b) => a.guests - b.guests);
          else if (sortBy === 'az') this.items = [...this.items].sort((a,b) => a.title.localeCompare(b.title, 'he'));
          else this.items = ${itemsJson};
        });
      }
    }`}
  >
    <div class="grid sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-10">
      <template x-for="w in items" :key="w.slug">
        <div>
          <template x-if="w.slug === 'ayelet-and-daniel'">
            <a :href="`/he/gallery/${w.slug}/`" class="group block relative overflow-hidden aspect-[4/5]">
              <img :src="w.photo" :alt="w.title" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
              <div class="absolute inset-0 bg-black/0 group-hover:bg-black/25 transition-colors flex items-center justify-center">
                <span class="opacity-0 group-hover:opacity-100 transition-opacity bg-brand-blue text-white text-sm font-bold rounded-full px-6 py-3">כניסה לחתונה ←</span>
              </div>
            </a>
          </template>
          <template x-if="w.slug !== 'ayelet-and-daniel'">
            <div class="group relative overflow-hidden aspect-[4/5]">
              <img :src="w.photo" :alt="w.title" class="absolute inset-0 w-full h-full object-cover transition-transform duration-300 group-hover:scale-105" />
            </div>
          </template>
          <div class="mt-3 flex items-baseline justify-between gap-3">
            <span class="script text-lg" x-text="w.title"></span>
            <span class="text-xs font-medium opacity-70 whitespace-nowrap" x-text="w.venue + ', ' + w.guests + ' אורחים'"></span>
          </div>
        </div>
      </template>
    </div>
  </section>

  <section class="bg-brand-red text-black py-20 text-center px-6">
    <h2 class="text-4xl md:text-5xl font-black">{gallery.closingH2}</h2>
    <p class="mt-4 text-lg font-medium">{gallery.closingBody}</p>
    <a href="/he/contact/" class="inline-block mt-6 bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">צור קשר ←</a>
  </section>
</Layout>
