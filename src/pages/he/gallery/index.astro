---
import Layout from '../../../layouts/Layout.astro';
import { gallery } from '../../../data/site.he';

const cardColors = ['bg-white', 'bg-brand-mint', 'bg-brand-sky', 'bg-brand-yellow'];
const cardPhotos = ['/images/photos/frieda-simeon-1.webp', '/images/photos/bouquet-toss.webp', '/images/photos/frieda-simeon-4.webp', '/images/photos/neon-sign.webp', '/images/photos/frieda-simeon-7.webp', '/images/photos/stock-3.webp'];
---
<Layout lang="he" dir="rtl" title={gallery.title} description={gallery.description} canonical="https://bebke.co.il/he/gallery/">
  <section class="bg-brand-mint px-6 py-20 text-center">
    <h1 class="text-5xl md:text-7xl font-black">{gallery.heroH1}</h1>
    <p class="mt-4 max-w-2xl mx-auto text-lg font-medium">{gallery.heroSub}</p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 grid sm:grid-cols-2 md:grid-cols-3 gap-6">
    {gallery.weddings.map((w, i) => (
      <a href={w.slug === 'ayelet-and-daniel' ? `/he/gallery/${w.slug}/` : '/he/gallery/'} class="group block border-2 border-black overflow-hidden bg-white">
        <div class="relative aspect-[4/5] overflow-hidden">
          <img src={cardPhotos[i % cardPhotos.length]} alt={w.title} class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <div class="p-5">
          <h3 class="font-black text-xl">{w.title}</h3>
          <p class="mt-2 text-sm font-medium opacity-80">{w.venue}</p>
          <p class="mt-1 text-sm font-bold">{w.guests} אורחים</p>
        </div>
      </a>
    ))}
  </section>

  <section class="bg-brand-red text-black py-20 text-center px-6">
    <h2 class="text-4xl md:text-5xl font-black">{gallery.closingH2}</h2>
    <p class="mt-4 text-lg font-medium">{gallery.closingBody}</p>
    <a href="/he/contact/" class="inline-block mt-6 bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">צור קשר ←</a>
  </section>
</Layout>
