---
import Layout from '../../../layouts/Layout.astro';
import { blog } from '../../../data/site.he';
---
<Layout lang="he" dir="rtl" title={blog.title} description={blog.description} canonical="https://bebke.co.il/he/blog/">
  <section class="bg-brand-cream px-6 py-20 text-center">
    <h1 class="text-5xl md:text-7xl font-black">{blog.heroH1}</h1>
    <p class="mt-4 max-w-2xl mx-auto text-lg font-medium">{blog.heroSub}</p>
  </section>

  <section class="bg-white py-8 px-6 border-y-2 border-black">
    <div class="max-w-6xl mx-auto flex flex-wrap gap-3 justify-center">
      {blog.categories.map((c) => (
        <span class="border-2 border-black rounded-full px-4 py-1 text-sm font-bold">{c}</span>
      ))}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-2 gap-8">
    {blog.posts.map((post) => (
      <article class="border-2 border-black p-6 hover:bg-brand-mint transition-colors">
        <p class="text-sm font-bold text-black/50">{post.date}</p>
        <h2 class="text-2xl font-black mt-2">{post.title}</h2>
        <p class="mt-3 text-black/70">{post.excerpt}</p>
      </article>
    ))}
  </section>

  <section class="bg-brand-green text-white py-16 px-6 text-center">
    <h2 class="text-2xl md:text-3xl font-black">{blog.footerIntroTitle}</h2>
    <p class="mt-4 max-w-2xl mx-auto">{blog.footerIntroBody}</p>
    <a href="/he/gallery/" class="inline-block mt-6 font-bold underline underline-offset-4">{blog.footerCta}</a>
  </section>

  <section class="bg-brand-red text-black py-16 px-6 text-center">
    <p class="text-xl font-bold">{blog.closingBody}</p>
    <a href="/he/contact/" class="inline-block mt-4 bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">{blog.closingCta}</a>
  </section>
</Layout>
