---
import Layout from '../../layouts/Layout.astro';
import { home } from '../../data/site.he';
---
<Layout lang="he" dir="rtl" title={home.title} description={home.description} canonical="https://bebke.co.il/he/">
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-16 text-center">
    <h1 class="text-4xl md:text-6xl font-serif font-semibold leading-tight">{home.heroH1}</h1>
    <p class="mt-6 text-lg text-stone-600 max-w-2xl mx-auto">{home.heroSub}</p>
    <a href="/he/contact/" class="inline-block mt-8 bg-rose-600 text-white px-8 py-3 rounded-full font-semibold hover:bg-rose-700 transition-colors">{home.heroCta}</a>
  </section>

  <section class="bg-white py-14 border-y border-stone-100">
    <p class="max-w-3xl mx-auto px-6 text-center text-lg text-stone-700">{home.introStrip}</p>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16 grid md:grid-cols-4 gap-8">
    {home.pillars.map((p) => (
      <div class="p-6 border border-stone-200 rounded-xl">
        <h3 class="font-serif text-xl font-semibold mb-2">{p.title}</h3>
        <p class="text-stone-600 text-sm">{p.body}</p>
      </div>
    ))}
  </section>

  <section class="bg-stone-100 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-2xl font-serif font-semibold mb-8 text-center">חתונות נבחרות</h2>
      <div class="grid md:grid-cols-3 gap-8">
        {home.featuredWeddings.map((w) => (
          <a href={w.href} class="block bg-white rounded-xl p-6 border border-stone-200 hover:shadow-lg transition-shadow">
            <h3 class="font-serif text-lg font-semibold">{w.title}</h3>
            {w.couple && <p class="text-stone-500 text-sm mt-1">{w.couple}</p>}
          </a>
        ))}
      </div>
      <div class="text-center mt-10">
        <a href="/he/gallery/" class="font-semibold text-rose-600 hover:underline">{home.galleryCta}</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-serif font-semibold mb-8 text-center">מהבלוג שלנו</h2>
    <ul class="grid md:grid-cols-3 gap-6">
      {home.blogPosts.map((post) => (
        <li class="p-5 border border-stone-200 rounded-xl text-stone-700">{post}</li>
      ))}
    </ul>
    <div class="text-center mt-10">
      <a href="/he/blog/" class="font-semibold text-rose-600 hover:underline">{home.blogCta}</a>
    </div>
  </section>

  <section class="bg-rose-600 text-white py-16 text-center">
    <h2 class="text-3xl font-serif font-semibold">{home.closingH2}</h2>
    <p class="mt-4">{home.closingBody}</p>
    <a href="/he/contact/" class="inline-block mt-6 bg-white text-rose-600 px-8 py-3 rounded-full font-semibold hover:bg-stone-100 transition-colors">{home.closingCta}</a>
  </section>
</Layout>
