---
import Layout from '../../layouts/Layout.astro';
import { home } from '../../data/site.he';

const blocks = ['bg-brand-green text-white', 'bg-brand-yellow text-black', 'bg-brand-mint text-black', 'bg-brand-sky text-black'];
const pillarPhotos = [null, '/images/photos/frieda-simeon-3.webp', '/images/photos/bouquet-toss.webp', null];
---
<Layout lang="he" dir="rtl" title={home.title} description={home.description} canonical="https://bebke.co.il/he/">
  <section class="relative text-white overflow-hidden">
    <img src="/images/photos/frieda-simeon-1.webp" alt="חתונת בבקה" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/45"></div>
    <div class="absolute top-6 left-6 z-10 hidden sm:flex items-center justify-center w-28 h-28 rounded-full bg-brand-blue text-brand-yellow text-center text-xs font-bold leading-tight p-3 -rotate-6">
      תשכחו כל מה שאתם יודעים על חתונות
    </div>
    <div class="relative px-6 pt-16 pb-24 text-center">
      <h1 class="text-5xl md:text-8xl font-black leading-[0.95] tracking-tight max-w-5xl mx-auto">
        {home.heroH1}
      </h1>
      <p class="mt-6 text-white/80 max-w-2xl mx-auto">{home.heroSub}</p>
      <a href="/he/contact/" class="inline-block mt-10 bg-brand-red text-white border-2 border-white px-8 py-3 font-bold rounded-full hover:bg-white hover:text-brand-red transition-colors">{home.heroCta}</a>
    </div>
  </section>

  <section class="bg-brand-green text-white py-14">
    <p class="max-w-3xl mx-auto px-6 text-center text-lg md:text-xl font-medium">{home.introStrip}</p>
  </section>

  <section class="grid md:grid-cols-4">
    {home.pillars.map((p, i) => (
      pillarPhotos[i] ? (
        <div class="relative min-h-[260px] flex flex-col justify-end p-8 text-white overflow-hidden">
          <img src={pillarPhotos[i]} alt={p.title} class="absolute inset-0 w-full h-full object-cover" />
          <div class="absolute inset-0 bg-black/40"></div>
          <div class="relative">
            <h3 class="font-black text-2xl mb-3">{p.title}</h3>
            <p class="text-sm md:text-base font-medium opacity-90">{p.body}</p>
          </div>
        </div>
      ) : (
        <div class:list={["p-8 min-h-[260px] flex flex-col justify-center", blocks[i % blocks.length]]}>
          <h3 class="font-black text-2xl mb-3">{p.title}</h3>
          <p class="text-sm md:text-base font-medium opacity-90">{p.body}</p>
        </div>
      )
    ))}
  </section>

  <section class="bg-brand-yellow py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">חתונות <span class="script font-normal">נבחרות.</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        {home.featuredWeddings.map((w) => (
          <a href={w.href} class="block bg-white p-6 border-2 border-black hover:bg-black hover:text-white transition-colors">
            <h3 class="font-bold text-lg">{w.title}</h3>
            {w.couple && <p class="script text-xl mt-2">{w.couple}</p>}
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="/he/gallery/" class="font-bold text-lg underline underline-offset-4">{home.galleryCta}</a>
      </div>
    </div>
  </section>

  <section class="bg-brand-cream py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">מה <span class="script font-normal">חדש בבלוג.</span></h2>
      <ul class="grid md:grid-cols-3 gap-6">
        {home.blogPosts.map((post) => (
          <li class="p-6 bg-white border-2 border-black font-medium">{post}</li>
        ))}
      </ul>
      <div class="mt-10">
        <a href="/he/blog/" class="font-bold text-lg underline underline-offset-4">{home.blogCta}</a>
      </div>
    </div>
  </section>

  <section class="bg-brand-red text-black py-24 text-center px-6">
    <h2 class="text-4xl md:text-6xl font-black">{home.closingH2}</h2>
    <p class="mt-4 text-lg font-medium">{home.closingBody}</p>
    <a href="/he/contact/" class="inline-block mt-8 bg-black text-brand-red px-8 py-3 font-bold rounded-full hover:bg-white hover:text-black border-2 border-black transition-colors">{home.closingCta}</a>
  </section>
</Layout>
