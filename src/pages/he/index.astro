---
import Layout from '../../layouts/Layout.astro';
import { home } from '../../data/site.he';
---
<Layout lang="he" dir="rtl" title={home.title} description={home.description} canonical="https://bebke.co.il/he/">
  <!-- Hero -->
  <section class="relative text-white overflow-hidden">
    <img src="/images/photos/hero-van-festival.webp" alt="חברים חוגגים ברכב מקושט בפרחים בפסטיבל" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/35"></div>
    <a href="/he/contact/" aria-label="חייגו לבבקה" class="absolute top-6 right-6 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/90 text-brand-blue hover:bg-white">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="3.2" />
      </svg>
    </a>
    <div class="absolute top-6 left-6 z-10 hidden sm:flex items-center justify-center w-28 h-28 rounded-full bg-brand-blue text-brand-yellow text-center text-xs font-bold leading-tight p-3 -rotate-6 animate-[spin_20s_linear_infinite]">
      תמחקו כל מה שאתם חושבים שאתם יודעים על חתונות
    </div>
    <div class="relative px-6 pt-24 pb-28 md:pt-32 md:pb-40 text-center">
      <h1 class="text-4xl md:text-6xl font-black leading-tight">{home.heroH1}</h1>
      <p class="mt-2 text-xl md:text-2xl font-medium">אבל לא כאלה שכולם מכירים.</p>
      <p class="mt-6 text-white/80 max-w-2xl mx-auto">{home.heroSub}</p>
      <a href="/he/contact/" class="inline-block mt-10 bg-brand-red text-white border-2 border-white px-8 py-3 font-bold rounded-full hover:bg-white hover:text-brand-red transition-colors">{home.heroCta}</a>
    </div>
  </section>

  <!-- Photo mosaic / services / pillars -->
  <section class="bg-white">
    <div class="grid grid-cols-2 md:grid-cols-3 auto-rows-[46vw] sm:auto-rows-[230px]">

      <!-- Our services -->
      <div class="bg-brand-green text-white p-8 flex flex-col justify-end row-span-2">
        <h2 class="text-4xl md:text-5xl font-black leading-none">השירותים <span class="script font-normal">שלנו.</span></h2>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-13.webp" alt="אורחים חוגגים בחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-12-couple.webp" alt="כלה וחתן צוחקים יחד" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Services copy tile -->
      <div class="bg-brand-yellow text-brand-blue p-8 flex flex-col justify-center row-span-2 md:col-span-1">
        <p class="text-sm md:text-base font-bold leading-relaxed">{home.introStrip}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1 md:row-span-2">
        <img src="/images/photos/neon-sign.webp" alt="שלט ניאון מותאם אישית מפרט חתונה, עמית ואורית" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Bespoke by Design -->
      <div class="bg-brand-sky text-black p-8 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[0].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[0].body}</p>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-01.webp" alt="פרט פרחוני מהחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Horse guy tile -->
      <div class="relative overflow-hidden bg-brand-red row-span-2">
        <img src="/images/photos/horse-guy.webp" alt="אורח משועשע במסכת סוס בחתונת בבקה" class="absolute inset-0 w-full h-full object-cover object-top" />
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1">
        <img src="/images/mosaic/mosaic-02.webp" alt="בר וקוקטיילים בחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-03.webp" alt="עיצוב שולחן עם ענפי זית ולימונים" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Local expertise -->
      <div class="bg-brand-green text-white p-8 flex flex-col justify-center col-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[1].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[1].body}</p>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-04.webp" alt="פרט לבוש רשמי לחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1 row-span-2">
        <img src="/images/mosaic/mosaic-09-horse.webp" alt="סוס באתר חתונת טבע" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-14.webp" alt="אורחים חוגגים סביב שולחן משפחתי" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-15.webp" alt="ילדים נהנים מגלידה בחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Contact us tile -->
      <a href="/he/contact/" class="group relative overflow-hidden col-span-2 md:col-span-1 row-span-2">
        <img src="/images/mosaic/mosaic-16.webp" alt="פרט מחתונת בבקה" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-90 transition-opacity" />
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative h-full flex items-center p-8">
          <h3 class="text-4xl md:text-5xl font-black text-white">צרו <span class="script font-normal text-brand-yellow">קשר</span></h3>
        </div>
      </a>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-05.webp" alt="זר ורדים וחרציות" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-06.webp" alt="קוקטיילים ותוצרת טרייה בבר" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Award winning -->
      <div class="bg-brand-sky text-black p-8 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[2].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[2].body}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1">
        <img src="/images/mosaic/mosaic-07.webp" alt="פינת ישיבה מעוצבת בחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-08.webp" alt="פרט עיצוב מהחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: With you A to Z -->
      <div class="bg-brand-yellow text-brand-blue p-8 flex flex-col justify-center col-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[3].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[3].body}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-3">
        <img src="/images/mosaic/mosaic-10.webp" alt="פרט חגיגה מהחתונה" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Testimonial carousel -->
  <section class="bg-brand-blue text-white py-24 px-6" x-data="{ slide: 0, testimonials: [
    { quote: home.testimonials[0].quote, author: home.testimonials[0].author },
    { quote: home.testimonials[1].quote, author: home.testimonials[1].author },
  ] }">
    <div class="max-w-3xl mx-auto text-center min-h-[260px] flex flex-col justify-center">
      <template x-for="(t, i) in testimonials" :key="i">
        <div x-show="slide === i" x-transition.duration.500ms>
          <p class="text-2xl md:text-3xl font-medium leading-snug" x-text="t.quote"></p>
          <p class="mt-6 script text-2xl text-brand-yellow" x-text="t.author"></p>
        </div>
      </template>
      <div class="mt-10 flex items-center justify-center gap-2">
        <template x-for="(t, i) in testimonials" :key="'dot'+i">
          <button type="button" @click="slide = i" class="w-2.5 h-2.5 rounded-full transition-colors" :class="slide === i ? 'bg-brand-yellow' : 'bg-white/50'" :aria-label="'עדות ' + (i + 1)" :aria-current="slide === i"></button>
        </template>
      </div>
    </div>
  </section>

  <!-- Creation Lab teaser -->
  <section class="bg-brand-cream py-20 px-6 text-center">
    <p class="uppercase tracking-wide text-sm font-bold mb-3">מתכננים את היום הגדול שלכם?</p>
    <h2 class="text-3xl md:text-5xl font-black">אנחנו רוצים <span class="script font-normal">להכיר אתכם קודם.</span></h2>
    <a href="/he/contact/" class="inline-block mt-8 bg-black text-white px-8 py-3 font-bold rounded-full hover:bg-brand-red transition-colors">נתחיל לדבר ←</a>
  </section>

  <!-- Backstage -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">מאחורי <span class="script font-normal">הקלעים.</span></h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-2.webp" alt="מאחורי הקלעים, בניית קשת החתונה" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-7.webp" alt="הרכב החי נערך לפני הטקס" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-6.webp" alt="הפרטים האחרונים לפני הריקוד הראשון" class="absolute inset-0 w-full h-full object-cover" /></div>
      </div>
      <p class="mt-8 max-w-2xl text-lg font-medium">הרגעים שאף אורח לא רואה: צוות בונה את השדה מאפס, בודק כל תזמון, כדי שביום עצמו כל שתרגישו זה הקסם.</p>
    </div>
  </section>

  <!-- Contact form teaser -->
  <section class="bg-white py-20 px-6 border-t-2 border-black">
    <div class="max-w-3xl mx-auto" x-data="{ sent: false }">
      <h2 class="text-4xl md:text-6xl font-black">בואו <span class="script font-normal">נתחיל לתכנן</span></h2>
      <p class="mt-4 font-medium text-lg">{home.closingBody}</p>
      <form class="mt-10 space-y-4" @submit.prevent="sent = true">
        <input type="text" name="name" placeholder="השם שלכם" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="email" name="email" placeholder="אימייל" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="tel" name="phone" placeholder="טלפון" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" />
        <textarea name="message" placeholder="אני רוצה ליצור אירוע מיוחד, משהו ייחודי. יש לי כמה רעיונות בראש:" rows="4" class="w-full bg-transparent border-2 border-black p-3 font-medium placeholder-black/60 focus:outline-none"></textarea>
        <button type="submit" class="bg-brand-blue text-white px-8 py-3 font-bold rounded-full hover:bg-black transition-colors" x-show="!sent">{home.closingCta}</button>
        <p x-show="sent" x-cloak class="font-bold text-lg">תודה! ניצור איתכם קשר בהקדם. 🎉</p>
      </form>
    </div>
  </section>

  <section class="bg-brand-yellow py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">חתונות <span class="script font-normal">נבחרות.</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        {home.featuredWeddings.map((w) => (
          <a href={w.href} class="block bg-white p-6 border-2 border-black hover:bg-black hover:text-white transition-colors">
            <h3 class="font-bold text-lg">{w.title}</h3>
            {w.couple && <p class="script text-xl mt-2">{w.couple}</p>}
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="/he/gallery/" class="font-bold text-lg underline underline-offset-4">{home.galleryCta}</a>
      </div>
    </div>
  </section>

  <section class="bg-brand-cream py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">מ<span class="script font-normal">הבלוג.</span></h2>
      <ul class="grid md:grid-cols-3 gap-6">
        {home.blogPosts.map((post) => (
          <li class="p-6 bg-white border-2 border-black font-medium">{post}</li>
        ))}
      </ul>
      <div class="mt-10">
        <a href="/he/blog/" class="font-bold text-lg underline underline-offset-4">{home.blogCta}</a>
      </div>
    </div>
  </section>
</Layout>
