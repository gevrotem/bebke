---
import Layout from '../../layouts/Layout.astro';
import { contact, contactInfo } from '../../data/site.he';
---
<Layout lang="he" dir="rtl" title={contact.title} description={contact.description} canonical="https://bebke.co.il/he/contact/">
  <section class="bg-brand-red text-black px-6 pt-16 pb-20 md:pt-24 md:pb-28">
    <div class="max-w-4xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-black leading-tight">בואו ניצור <span class="script">קסם</span>.</h1>
    </div>

    <div class="max-w-4xl mx-auto mt-16 md:mt-20 grid md:grid-cols-2 gap-10 md:gap-16">
      <div>
        <div class="flex items-center gap-4">
          <a href={`https://wa.me/${contactInfo.whatsapp.replace(/[^0-9]/g, '')}`} target="_blank" rel="noopener" aria-label="וואטסאפ" class="hover:opacity-70">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.29-1.39a9.9 9.9 0 0 0 4.75 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.85 9.85 0 0 0 12.04 2Zm0 18.13h-.01a8.2 8.2 0 0 1-4.19-1.15l-.3-.18-3.14.82.84-3.06-.2-.31a8.2 8.2 0 0 1-1.26-4.43c0-4.55 3.71-8.26 8.27-8.26 2.21 0 4.28.86 5.84 2.42a8.2 8.2 0 0 1 2.42 5.84c0 4.55-3.71 8.26-8.27 8.26Zm4.53-6.19c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.13-.17.25-.64.81-.78.97-.14.17-.29.19-.54.06-.25-.12-1.04-.38-1.98-1.22-.73-.65-1.23-1.46-1.37-1.7-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.43.12-.14.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.35-.77-1.85-.2-.48-.4-.42-.56-.42-.14-.01-.31-.01-.48-.01a.93.93 0 0 0-.67.31c-.23.25-.87.85-.87 2.08s.89 2.41 1.02 2.58c.12.17 1.75 2.67 4.24 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.55.1.47-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.07-.11-.23-.17-.48-.29Z"/></svg>
          </a>
          <a href="tel:+972977990220" aria-label="התקשרו לבבקה" class="hover:opacity-70">
            <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 5c0-1.1.9-2 2-2h2.28a1 1 0 0 1 .97.76l.9 3.6a1 1 0 0 1-.27.96l-1.7 1.7a12.05 12.05 0 0 0 5.7 5.7l1.7-1.7a1 1 0 0 1 .96-.27l3.6.9a1 1 0 0 1 .76.97V18c0 1.1-.9 2-2 2h-1C9.16 20 4 14.84 4 8.5V5Z"/></svg>
          </a>
        </div>
        <div class="mt-4 space-y-1 text-sm font-medium">
          <p>טלפון (ללא עלות): {contactInfo.phoneTollFree}</p>
          <p>נייד / וואטסאפ: {contactInfo.whatsapp}</p>
          <p>משרד: {contactInfo.israelOffice}</p>
          <p>אימייל: {contactInfo.email}</p>
        </div>

        <div class="mt-10">
          <p class="text-xs font-bold uppercase tracking-wide mb-3">עקבו אחרינו:</p>
          <div class="flex gap-4">
            <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="פינטרסט" class="flex items-center justify-center h-9 w-9 rounded-full border-2 border-black hover:bg-black hover:text-brand-red transition-colors"><img src="/images/social/pinterest.webp" alt="Pinterest" class="h-4 w-auto" /></a>
            <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="פייסבוק" class="flex items-center justify-center h-9 w-9 rounded-full border-2 border-black hover:bg-black hover:text-brand-red transition-colors"><img src="/images/social/facebook.webp" alt="Facebook" class="h-4 w-auto" /></a>
            <a href="https://vimeo.com" target="_blank" rel="noopener" aria-label="וימאו" class="flex items-center justify-center h-9 w-9 rounded-full border-2 border-black hover:bg-black hover:text-brand-red transition-colors"><img src="/images/social/vimeo.webp" alt="Vimeo" class="h-4 w-auto" /></a>
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="אינסטגרם" class="flex items-center justify-center h-9 w-9 rounded-full border-2 border-black hover:bg-black hover:text-brand-red transition-colors"><img src="/images/social/instagram.webp" alt="Instagram" class="h-4 w-auto" /></a>
          </div>
        </div>
      </div>

      <form class="space-y-5" x-data="{ sent: false }" @submit.prevent="sent = true">
        <div>
          <label for="name" class="block text-xs font-bold uppercase tracking-wide mb-1">{contact.formFields.name}</label>
          <input id="name" type="text" name="name" class="w-full bg-transparent border-b-2 border-black py-1.5 font-medium focus:outline-none" required />
        </div>
        <div class="grid grid-cols-2 gap-6">
          <div>
            <label for="email" class="block text-xs font-bold uppercase tracking-wide mb-1">{contact.formFields.email}</label>
            <input id="email" type="email" name="email" class="w-full bg-transparent border-b-2 border-black py-1.5 font-medium focus:outline-none" required />
          </div>
          <div>
            <label for="phone" class="block text-xs font-bold uppercase tracking-wide mb-1">{contact.formFields.phone}</label>
            <input id="phone" type="tel" name="phone" class="w-full bg-transparent border-b-2 border-black py-1.5 font-medium focus:outline-none" />
          </div>
        </div>
        <textarea name="message" rows="4" placeholder={contact.formFields.message} class="w-full bg-transparent border-2 border-black rounded-md p-3 font-medium placeholder-black/60 focus:outline-none"></textarea>
        <button type="submit" class="bg-transparent text-black border-2 border-black px-8 py-3 font-bold rounded-full hover:bg-black hover:text-brand-red transition-colors" x-show="!sent">{contact.formFields.submit}</button>
        <p x-show="sent" x-cloak class="font-bold text-lg">תודה! ניצור איתך קשר בקרוב 🎉</p>
      </form>
    </div>
  </section>
</Layout>
