---
import Layout from '../../layouts/Layout.astro';
import { about } from '../../data/site.he';

const valueColors = ['bg-brand-green text-white', 'bg-brand-yellow text-black', 'bg-brand-mint text-black', 'bg-brand-sky text-black', 'bg-black text-white'];
---
<Layout lang="he" dir="rtl" title={about.title} description={about.description} canonical="https://bebke.co.il/he/about/">
  <section class="relative text-white px-6 pt-20 pb-24 text-center overflow-hidden">
    <img src="/images/photos/frieda-simeon-5.webp" alt="זוג בחתונת בבקה" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-brand-red/80"></div>
    <div class="relative">
      <h1 class="text-5xl md:text-8xl font-black">{about.heroH1}</h1>
      <p class="mt-4 font-bold text-lg">{about.heroSub}</p>
    </div>
  </section>

  <section class="bg-brand-yellow py-16">
    <p class="max-w-3xl mx-auto px-6 text-center text-lg md:text-xl font-medium">{about.intro}</p>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 text-center">
    <p class="text-lg text-black/80">{about.processIntro}</p>
    <p class="text-lg text-black/80 mt-4">{about.processIntro2}</p>
  </section>

  <section class="bg-black text-white py-16">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10 text-center">התהליך <span class="script font-normal">שלנו.</span></h2>
      <ol class="grid md:grid-cols-4 gap-6">
        {about.process.map((step, i) => (
          <li class="border-2 border-white/30 p-5">
            <span class="script text-2xl text-brand-yellow">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="font-bold text-lg mt-2">{step.title}</h3>
            <p class="text-sm text-white/70 mt-1">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-brand-mint py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10 text-center">הערכים <span class="script font-normal">שלנו.</span></h2>
      <div class="grid md:grid-cols-5 gap-4">
        {about.values.map((v, i) => (
          <div class:list={["p-5 min-h-[200px] flex flex-col justify-center text-center", valueColors[i % valueColors.length]]}>
            <h3 class="font-black text-lg mb-2">{v.title}</h3>
            <p class="text-sm font-medium opacity-90">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-brand-sky py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">מה אנחנו <span class="script font-normal">עושים.</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        {about.whatWeDo.map((item) => (
          <div class="bg-white p-6 border-2 border-black">
            <h3 class="font-bold text-lg mb-2">{item.title}</h3>
            <p class="text-sm text-black/70">{item.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-10 flex items-end gap-6">
        <img src="/images/photos/horse-guy.webp" alt="לא עוד חתונה רגילה" class="h-40 md:h-56 w-auto" />
        <p class="script text-2xl md:text-3xl">אף פעם לא חתונה רגילה.</p>
      </div>
    </div>
  </section>

  <section class="bg-brand-red text-black py-24 text-center px-6">
    <h2 class="text-4xl md:text-6xl font-black">{about.closingH2}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/he/gallery/" class="bg-white text-black border-2 border-black px-8 py-3 font-bold rounded-full hover:bg-black hover:text-white transition-colors">{about.galleryCta}</a>
      <a href="/he/contact/" class="bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">{about.contactCta}</a>
    </div>
  </section>
</Layout>
