---
import Layout from '../../layouts/Layout.astro';
import { about } from '../../data/site.he';

const valueColors = ['bg-brand-green text-white', 'bg-brand-yellow text-black', 'bg-brand-mint text-black', 'bg-brand-sky text-black', 'bg-black text-white'];
const processIcons = ['/images/process/01.webp', '/images/process/02.webp', '/images/process/03.webp', '/images/process/04.webp', '/images/process/05.webp', '/images/process/06.webp', '/images/process/07.webp', '/images/process/08.webp'];
---
<Layout lang="he" dir="rtl" title={about.title} description={about.description} canonical="https://bebke.co.il/he/about/">
  <section class="relative text-white px-6 pt-24 pb-16 text-center overflow-hidden">
    <img src="/images/about/hero-this-is-bebke.webp" alt="מייסדי בבקה, ענבר וגבע רותם" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/25"></div>
    <div class="relative">
      <h1 class="text-5xl md:text-8xl font-black">{about.heroH1}</h1>
      <p class="mt-6 font-bold text-lg">{about.heroSub}</p>
    </div>
  </section>

  <section class="bg-brand-yellow py-16">
    <div class="max-w-3xl mx-auto px-6 text-center">
      <h2 class="text-3xl md:text-4xl font-black mb-6">מי <span class="script font-normal">אנחנו?</span></h2>
      <p class="text-lg md:text-xl font-medium">{about.intro}</p>
    </div>
  </section>

  <section class="bg-brand-yellow py-16 text-center">
    <div class="max-w-md mx-auto px-6">
      <span class="text-2xl">🔊</span>
      <h2 class="text-4xl md:text-5xl font-black mt-2">{about.pronunciation.word}</h2>
      <p class="script text-3xl mt-1">{about.pronunciation.ipa}</p>
      <p class="italic mt-4 text-black/80">{about.pronunciation.tagline}</p>
      <p class="text-sm text-black/60 mt-1">{about.pronunciation.note}</p>
    </div>
  </section>

  <section class="max-w-4xl mx-auto px-6 py-16 text-center">
    <p class="text-lg text-black/80">{about.processIntro}</p>
    <p class="text-lg text-black/80 mt-4">{about.processIntro2}</p>
  </section>

  <section class="bg-brand-yellow py-16">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10 text-center">התהליך <span class="script font-normal">שלנו.</span></h2>
      <ol class="grid grid-cols-2 md:grid-cols-4 gap-x-6 gap-y-10">
        {about.process.map((step, i) => (
          <li class="text-right">
            <span class="text-xs font-bold text-black/50">{String(i + 1).padStart(2, '0')}</span>
            <div class="h-14 mt-1 mb-2 flex items-end"><img src={processIcons[i % processIcons.length]} alt={step.title} class="h-14 w-auto" loading="lazy" /></div>
            <h3 class="font-bold text-sm md:text-base">{step.title}</h3>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="bg-brand-yellow py-10">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-10 items-center">
      <div class="md:order-2">
        <img src="/images/photos/stock-4.webp" alt="הערכים שלנו" class="w-full h-72 object-cover" onerror="this.style.display='none'" />
      </div>
      <div class="md:order-1">
        <h2 class="text-4xl md:text-5xl font-black mb-6">הערכים <span class="script font-normal">שלנו.</span></h2>
        <ol class="space-y-2 text-lg font-medium">
          {about.values.map((v, i) => (
            <li>{i + 1}/ {v.title}</li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section class="bg-brand-yellow py-20">
    <div class="max-w-6xl mx-auto px-6">
      <div class="flex items-center gap-3 mb-10">
        <span class="text-3xl">🤙</span>
        <h2 class="text-4xl md:text-5xl font-black">מה אנחנו <span class="script font-normal">עושים?</span></h2>
      </div>
      <div class="grid md:grid-cols-2 gap-x-12 gap-y-8">
        {about.whatWeDoCategories.map((item) => (
          <div>
            <h3 class="font-black text-lg mb-2">{item.title}</h3>
            <p class="text-sm text-black/70 leading-relaxed">{item.body}</p>
          </div>
        ))}
      </div>
      <div class="mt-14 flex items-end gap-6">
        <img src="/images/photos/horse-guy.webp" alt="לא עוד חתונה רגילה" class="h-40 md:h-56 w-auto" />
        <p class="script text-2xl md:text-3xl">אף פעם לא חתונה רגילה.</p>
      </div>
    </div>
  </section>

  <section class="bg-brand-red text-black py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-black">רוצים לראות עוד <span class="script font-normal">חתונות?</span></h2>
    <a href="/he/gallery/" class="inline-block mt-6 border-2 border-black rounded-full px-8 py-3 font-bold hover:bg-black hover:text-brand-red transition-colors">לגלריה ←</a>
  </section>

  <section class="bg-brand-red text-black py-24 text-center px-6">
    <h2 class="text-4xl md:text-6xl font-black">{about.closingH2}</h2>
    <div class="mt-8 flex flex-wrap justify-center gap-4">
      <a href="/he/gallery/" class="bg-white text-black border-2 border-black px-8 py-3 font-bold rounded-full hover:bg-black hover:text-white transition-colors">{about.galleryCta}</a>
      <a href="/he/contact/" class="bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors">{about.contactCta}</a>
    </div>
  </section>
</Layout>
