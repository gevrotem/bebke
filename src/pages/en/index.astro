---
import Layout from '../../layouts/Layout.astro';
import { home } from '../../data/site.en';
---
<Layout lang="en" dir="ltr" title={home.title} description={home.description} canonical="https://bebke.com/en/">
  <!-- Hero -->
  <section class="relative text-white overflow-hidden">
    <img src="/images/photos/hero-van-festival.webp" alt="Friends celebrating in a flower-decorated van at a festival" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/35"></div>
    <a href="/en/contact/" aria-label="Call Bebke" class="absolute top-6 left-6 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/90 text-brand-blue hover:bg-white">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="3.2" />
      </svg>
    </a>
    <div class="absolute top-6 right-6 z-10 hidden sm:flex items-center justify-center w-28 h-28 rounded-full bg-brand-blue text-brand-yellow text-center text-xs font-bold leading-tight p-3 rotate-6 animate-[spin_20s_linear_infinite]">
      Erase everything you know about weddings
    </div>
    <div class="relative px-6 pt-24 pb-28 md:pt-32 md:pb-40 text-center">
      <img src="/images/brand/hero-headline.webp" alt="We Plan Weddings." class="mx-auto w-full max-w-3xl h-auto" />
      <p class="mt-2 text-xl md:text-2xl font-medium">But not the ordinary ones.</p>
      <p class="mt-6 text-white/80 max-w-2xl mx-auto">{home.heroSub}</p>
      <a href="/en/contact/" class="inline-block mt-10 bg-brand-red text-white border-2 border-white px-8 py-3 font-bold rounded-full hover:bg-white hover:text-brand-red transition-colors">{home.heroCta}</a>
    </div>
  </section>

  <section class="bg-brand-green text-white py-14">
    <p class="max-w-3xl mx-auto px-6 text-center text-lg md:text-xl font-medium">{home.introStrip}</p>
  </section>

  <!-- Photo mosaic / pillars -->
  <section class="bg-white">
    <div class="grid grid-cols-2 md:grid-cols-4 auto-rows-[42vw] sm:auto-rows-[220px]">
      <div class="relative overflow-hidden col-span-2 row-span-2">
        <img src="/images/photos/neon-sign.webp" alt="Custom neon sign wedding detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="bg-brand-green text-white p-6 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[0].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[0].body}</p>
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/photos/horse-guy.webp" alt="Playful costumed guest at a Bebke wedding" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="bg-brand-yellow text-black p-6 flex flex-col justify-center row-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[1].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[1].body}</p>
      </div>
      <div class="relative overflow-hidden col-span-2">
        <img src="/images/photos/bouquet-toss.webp" alt="Bride tossing the bouquet" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/photos/frieda-simeon-3.webp" alt="Bride and groom hands, close up" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="bg-brand-red text-white p-6 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[2].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[2].body}</p>
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/photos/frieda-simeon-9.webp" alt="Floral wedding cake" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="bg-brand-sky text-black p-6 flex flex-col justify-center col-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[3].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[3].body}</p>
      </div>
      <div class="relative overflow-hidden col-span-2">
        <img src="/images/photos/stock-3.webp" alt="Dinner table setting with candles and florals" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Contact CTA -->
  <section class="bg-brand-cream py-20 px-6 text-center">
    <h2 class="text-3xl md:text-5xl font-black">{home.closingH2}</h2>
    <p class="mt-4 text-lg font-medium max-w-2xl mx-auto">{home.closingBody}</p>
    <a href="/en/contact/" class="inline-block mt-8 bg-brand-blue text-white px-8 py-3 font-bold rounded-full hover:bg-black transition-colors">{home.closingCta}</a>
  </section>

  <section class="bg-brand-yellow py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">Featured <span class="script font-normal">Weddings.</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        {home.featuredWeddings.map((w) => (
          <a href={w.href} class="block bg-white p-6 border-2 border-black hover:bg-black hover:text-white transition-colors">
            <h3 class="font-bold text-lg">{w.title}</h3>
            {w.couple && <p class="script text-xl mt-2">{w.couple}</p>}
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="/en/gallery/" class="font-bold text-lg underline underline-offset-4">{home.galleryCta}</a>
      </div>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="bg-brand-blue text-white py-24 px-6" x-data="{ slide: 0, total: 1 }">
    <div class="max-w-3xl mx-auto text-center">
      <p class="text-2xl md:text-3xl font-medium leading-snug">"After a quick search online, we came across pictures of Bebke's events. Every single one was unique and special. Then we saw the line: 'For couples who want a different kind of wedding.' Bingo."</p>
      <p class="mt-6 script text-2xl text-brand-yellow">Mor & Rotem</p>
      <div class="mt-8 flex items-center justify-center gap-2">
        <button type="button" class="w-2.5 h-2.5 rounded-full bg-brand-yellow" aria-label="Testimonial 1" aria-current="true"></button>
      </div>
    </div>
  </section>

  <!-- Creation Lab teaser -->
  <section class="bg-brand-cream py-20 px-6 text-center">
    <h2 class="text-3xl md:text-5xl font-black">The <span class="script font-normal">Creation Lab.</span></h2>
    <p class="mt-4 text-lg font-medium max-w-2xl mx-auto">Behind every Bebke wedding is a workshop of ideas — where props, sets and moments are dreamed up long before the big day.</p>
    <a href="#" class="inline-block mt-8 bg-black text-white px-8 py-3 font-bold rounded-full hover:bg-brand-red transition-colors">Explore the Creation Lab →</a>
  </section>

  <!-- Backstage -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">Back<span class="script font-normal">stage.</span></h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-2.webp" alt="Behind the scenes, building the wedding arch" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-7.webp" alt="Live band setting up before the ceremony" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-6.webp" alt="Final details before the couple's first dance" class="absolute inset-0 w-full h-full object-cover" /></div>
      </div>
      <p class="mt-8 max-w-2xl text-lg font-medium">The moments no guest sees: a team building the field from scratch, testing every cue, so that on the day itself all you feel is the magic.</p>
    </div>
  </section>

  <section class="bg-brand-cream py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">From the <span class="script font-normal">Blog.</span></h2>
      <ul class="grid md:grid-cols-3 gap-6">
        {home.blogPosts.map((post) => (
          <li class="p-6 bg-white border-2 border-black font-medium">{post}</li>
        ))}
      </ul>
      <div class="mt-10">
        <a href="/en/blog/" class="font-bold text-lg underline underline-offset-4">{home.blogCta}</a>
      </div>
    </div>
  </section>
</Layout>
