---
import Layout from '../../layouts/Layout.astro';
import { home } from '../../data/site.en';
---
<Layout lang="en" dir="ltr" title={home.title} description={home.description} canonical="https://bebke.com/en/">
  <!-- Hero -->
  <section class="relative text-white overflow-hidden">
    <img src="/images/photos/hero-van-festival.webp" alt="Friends celebrating in a flower-decorated van at a festival" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/35"></div>
    <a href="/en/contact/" aria-label="Call Bebke" class="absolute top-6 left-6 z-10 flex items-center justify-center w-12 h-12 rounded-full bg-white/90 text-brand-blue hover:bg-white">
      <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <circle cx="12" cy="12" r="9" />
        <circle cx="12" cy="12" r="3.2" />
      </svg>
    </a>
    <div class="absolute top-6 right-6 z-10 hidden sm:flex items-center justify-center w-28 h-28 rounded-full bg-brand-blue text-brand-yellow text-center text-xs font-bold leading-tight p-3 rotate-6 animate-[spin_20s_linear_infinite]">
      Erase everything you know about weddings
    </div>
    <div class="relative px-6 pt-24 pb-28 md:pt-32 md:pb-40 text-center">
      <img src="/images/brand/hero-headline.webp" alt="We Plan Weddings." class="mx-auto w-full max-w-3xl h-auto" />
      <p class="mt-2 text-xl md:text-2xl font-medium">But not the ordinary ones.</p>
      <p class="mt-6 text-white/80 max-w-2xl mx-auto">{home.heroSub}</p>
      <a href="/en/contact/" class="inline-block mt-10 bg-brand-red text-white border-2 border-white px-8 py-3 font-bold rounded-full hover:bg-white hover:text-brand-red transition-colors">{home.heroCta}</a>
    </div>
  </section>

  <!-- Photo mosaic / services / pillars -->
  <section class="bg-white">
    <div class="grid grid-cols-2 md:grid-cols-3 auto-rows-[46vw] sm:auto-rows-[230px]">

      <!-- Our services -->
      <div class="bg-brand-green text-white p-8 flex flex-col justify-end row-span-2">
        <h2 class="text-4xl md:text-5xl font-black leading-none">Our <span class="script font-normal">services.</span></h2>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-13.webp" alt="Wedding guests celebrating" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-12-couple.webp" alt="Bride and groom laughing together" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Services copy tile -->
      <div class="bg-brand-yellow text-brand-blue p-8 flex flex-col justify-center row-span-2 md:col-span-1">
        <p class="text-sm md:text-base font-bold leading-relaxed">{home.introStrip}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1 md:row-span-2">
        <img src="/images/photos/neon-sign.webp" alt="Custom neon sign wedding detail, Amit and Ort" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Bespoke by Design -->
      <div class="bg-brand-sky text-black p-8 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[0].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[0].body}</p>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-01.webp" alt="Wedding florals detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Horse guy tile -->
      <div class="relative overflow-hidden bg-brand-red row-span-2">
        <img src="/images/photos/horse-guy.webp" alt="Playful costumed guest in a horse mask at a Bebke wedding" class="absolute inset-0 w-full h-full object-cover object-top" />
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1">
        <img src="/images/mosaic/mosaic-02.webp" alt="Wedding bar and cocktail detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-03.webp" alt="Table setting decorated with olive branches and lemons" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Local expertise -->
      <div class="bg-brand-green text-white p-8 flex flex-col justify-center col-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[1].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[1].body}</p>
      </div>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-04.webp" alt="Formal wedding attire detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1 row-span-2">
        <img src="/images/mosaic/mosaic-09-horse.webp" alt="A horse at a nature wedding venue" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-14.webp" alt="Guests celebrating at a family table" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-15.webp" alt="Children enjoying ice cream at a wedding" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Contact us tile -->
      <a href="/en/contact/" class="group relative overflow-hidden col-span-2 md:col-span-1 row-span-2">
        <img src="/images/mosaic/mosaic-16.webp" alt="Bebke wedding detail" class="absolute inset-0 w-full h-full object-cover opacity-70 group-hover:opacity-90 transition-opacity" />
        <div class="absolute inset-0 bg-black/40"></div>
        <div class="relative h-full flex items-center p-8">
          <h3 class="text-4xl md:text-5xl font-black text-white">Contact <span class="script font-normal text-brand-yellow">us</span></h3>
        </div>
      </a>

      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-05.webp" alt="Bouquet of roses and daisies" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-06.webp" alt="Cocktails and fresh produce at the bar" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: Award winning -->
      <div class="bg-brand-sky text-black p-8 flex flex-col justify-center">
        <h3 class="font-black text-xl mb-2">{home.pillars[2].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[2].body}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-1">
        <img src="/images/mosaic/mosaic-07.webp" alt="Wedding lounge seating detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>
      <div class="relative overflow-hidden">
        <img src="/images/mosaic/mosaic-08.webp" alt="Wedding decor detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>

      <!-- Pillar: With you A to Z -->
      <div class="bg-brand-yellow text-brand-blue p-8 flex flex-col justify-center col-span-2">
        <h3 class="font-black text-xl mb-2">{home.pillars[3].title}</h3>
        <p class="text-sm font-medium opacity-90">{home.pillars[3].body}</p>
      </div>

      <div class="relative overflow-hidden col-span-2 md:col-span-3">
        <img src="/images/mosaic/mosaic-10.webp" alt="Wedding celebration detail" class="absolute inset-0 w-full h-full object-cover" />
      </div>
    </div>
  </section>

  <!-- Testimonial carousel -->
  <section class="bg-brand-blue text-white py-24 px-6" x-data="{ slide: 0, testimonials: [
    { quote: home.testimonials[0].quote, author: home.testimonials[0].author },
    { quote: home.testimonials[1].quote, author: home.testimonials[1].author },
  ] }">
    <div class="max-w-3xl mx-auto text-center min-h-[260px] flex flex-col justify-center">
      <template x-for="(t, i) in testimonials" :key="i">
        <div x-show="slide === i" x-transition.duration.500ms>
          <p class="text-2xl md:text-3xl font-medium leading-snug" x-text="t.quote"></p>
          <p class="mt-6 script text-2xl text-brand-yellow" x-text="t.author"></p>
        </div>
      </template>
      <div class="mt-10 flex items-center justify-center gap-2">
        <template x-for="(t, i) in testimonials" :key="'dot'+i">
          <button type="button" @click="slide = i" class="w-2.5 h-2.5 rounded-full transition-colors" :class="slide === i ? 'bg-brand-yellow' : 'bg-white/50'" :aria-label="'Testimonial ' + (i + 1)" :aria-current="slide === i"></button>
        </template>
      </div>
    </div>
  </section>

  <!-- Creation Lab teaser -->
  <section class="bg-brand-cream py-20 px-6 text-center">
    <p class="uppercase tracking-wide text-sm font-bold mb-3">Planning your big day?</p>
    <h2 class="text-3xl md:text-5xl font-black">We want <span class="script font-normal">to get to know you first.</span></h2>
    <a href="#" title="Coming soon" class="inline-block mt-8 bg-black text-white px-8 py-3 font-bold rounded-full hover:bg-brand-red transition-colors">Go to the Creation Lab →</a>
  </section>

  <!-- Backstage -->
  <section class="bg-white py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">Back<span class="script font-normal">stage.</span></h2>
      <div class="grid md:grid-cols-3 gap-4">
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-2.webp" alt="Behind the scenes, building the wedding arch" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-7.webp" alt="Live band setting up before the ceremony" class="absolute inset-0 w-full h-full object-cover" /></div>
        <div class="relative overflow-hidden h-56"><img src="/images/photos/frieda-simeon-6.webp" alt="Final details before the couple's first dance" class="absolute inset-0 w-full h-full object-cover" /></div>
      </div>
      <p class="mt-8 max-w-2xl text-lg font-medium">The moments no guest sees: a team building the field from scratch, testing every cue, so that on the day itself all you feel is the magic.</p>
    </div>
  </section>

  <!-- Contact form teaser -->
  <section class="bg-white py-20 px-6 border-t-2 border-black">
    <div class="max-w-3xl mx-auto" x-data="{ sent: false }">
      <h2 class="text-4xl md:text-6xl font-black">Let's start <span class="script font-normal">planning</span></h2>
      <p class="mt-4 font-medium text-lg">{home.closingBody}</p>
      <form class="mt-10 space-y-4" @submit.prevent="sent = true">
        <input type="text" name="name" placeholder="Your name" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="email" name="email" placeholder="Email" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="tel" name="phone" placeholder="Phone" class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" />
        <textarea name="message" placeholder="I want to create a special event, something unique. I have a few ideas in mind:" rows="4" class="w-full bg-transparent border-2 border-black p-3 font-medium placeholder-black/60 focus:outline-none"></textarea>
        <button type="submit" class="bg-brand-blue text-white px-8 py-3 font-bold rounded-full hover:bg-black transition-colors" x-show="!sent">{home.closingCta}</button>
        <p x-show="sent" x-cloak class="font-bold text-lg">Thank you! We'll be in touch shortly. 🎉</p>
      </form>
    </div>
  </section>

  <section class="bg-brand-yellow py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">Featured <span class="script font-normal">Weddings.</span></h2>
      <div class="grid md:grid-cols-3 gap-6">
        {home.featuredWeddings.map((w) => (
          <a href={w.href} class="block bg-white p-6 border-2 border-black hover:bg-black hover:text-white transition-colors">
            <h3 class="font-bold text-lg">{w.title}</h3>
            {w.couple && <p class="script text-xl mt-2">{w.couple}</p>}
          </a>
        ))}
      </div>
      <div class="mt-10">
        <a href="/en/gallery/" class="font-bold text-lg underline underline-offset-4">{home.galleryCta}</a>
      </div>
    </div>
  </section>

  <section class="bg-brand-cream py-20">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-4xl md:text-5xl font-black mb-10">From the <span class="script font-normal">Blog.</span></h2>
      <ul class="grid md:grid-cols-3 gap-6">
        {home.blogPosts.map((post) => (
          <li class="p-6 bg-white border-2 border-black font-medium">{post}</li>
        ))}
      </ul>
      <div class="mt-10">
        <a href="/en/blog/" class="font-bold text-lg underline underline-offset-4">{home.blogCta}</a>
      </div>
    </div>
  </section>
</Layout>
