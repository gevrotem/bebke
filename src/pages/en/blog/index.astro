---
import Layout from '../../../layouts/Layout.astro';
import { blog } from '../../../data/site.en';

const postPhotos = [
  '/images/mosaic/mosaic-01.webp',
  '/images/mosaic/mosaic-13.webp',
  '/images/mosaic/mosaic-04.webp',
  '/images/mosaic/mosaic-06.webp',
  '/images/mosaic/mosaic-07.webp',
];
---
<Layout lang="en" dir="ltr" title={blog.title} description={blog.description} canonical="https://bebke.com/en/blog/">
  <section class="bg-brand-cream px-6 py-20 text-center">
    <h1 class="text-5xl md:text-7xl font-black">Welcome to our <span class="script font-normal">blog.</span></h1>
    <p class="mt-4 max-w-2xl mx-auto text-lg font-medium">{blog.heroSub}</p>
  </section>

  <section class="bg-white py-8 px-6 border-y-2 border-black">
    <div class="max-w-6xl mx-auto flex flex-wrap gap-3 justify-center">
      {blog.categories.map((c) => (
        <span class="border-2 border-black rounded-full px-4 py-1 text-sm font-bold">{c}</span>
      ))}
    </div>
  </section>

  <section class="bg-brand-cream px-6 pt-10">
    <div class="max-w-6xl mx-auto flex justify-end">
      <select class="border-2 border-black rounded-full px-4 py-2 font-bold text-sm bg-white">
        <option>Sort By: Newest</option>
        <option>Sort By: Oldest</option>
        <option>Sort By: Most Popular</option>
      </select>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-10 grid sm:grid-cols-2 lg:grid-cols-4 gap-8">
    {blog.posts.map((post, i) => (
      <article class="group flex flex-col">
        <div class="overflow-hidden">
          <img src={postPhotos[i % postPhotos.length]} alt={post.title} width="400" height="288" class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300" />
        </div>
        <p class="text-xs font-bold text-black/50 mt-3">{post.date}</p>
        <h2 class="text-lg font-black mt-1 leading-snug">{post.title}</h2>
        <p class="text-sm text-black/60 mt-2 flex-1">{post.excerpt}</p>
        <a href="/en/blog/" class="mt-3 text-sm font-bold underline underline-offset-4 hover:no-underline">Read more →</a>
      </article>
    ))}
  </section>

  <div class="text-center pb-16 bg-brand-cream">
    <button class="border-2 border-black rounded-full px-8 py-3 font-bold hover:bg-black hover:text-white transition-colors">Load more</button>
  </div>

  <section class="relative text-white overflow-hidden">
    <img src="/images/mosaic/mosaic-12-couple.webp" alt="What is Bebke?" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/40"></div>
    <div class="relative px-6 py-24 text-center">
      <h2 class="text-4xl md:text-5xl font-black">What is <span class="script font-normal">Bebke?</span></h2>
      <p class="mt-3 max-w-xl mx-auto">{blog.footerIntroBody}</p>
      <a href="/en/gallery/" class="inline-block mt-6 border-2 border-white rounded-full px-8 py-3 font-bold hover:bg-white hover:text-black transition-colors">{blog.footerCta}</a>
    </div>
  </section>

  <section class="bg-brand-red text-black py-16 px-6 text-center">
    <h2 class="text-3xl md:text-4xl font-black">Show me more <span class="script font-normal">weddings.</span></h2>
    <a href="/en/gallery/" class="inline-block mt-6 border-2 border-black rounded-full px-8 py-3 font-bold hover:bg-black hover:text-white transition-colors">Go to the Creation Lab →</a>
  </section>

  <section class="bg-black text-white py-16 px-6 text-center">
    <p class="text-xl font-bold">{blog.closingBody}</p>
    <a href="/en/contact/" class="inline-block mt-4 bg-brand-red text-black px-8 py-3 font-bold rounded-full border-2 border-brand-red hover:bg-white hover:text-black transition-colors">{blog.closingCta}</a>
  </section>
</Layout>
