---
import Layout from '../../layouts/Layout.astro';
import { about } from '../../data/site.en';
---
<Layout lang="en" dir="ltr" title={about.title} description={about.description} canonical="https://bebke.com/en/about/">
  <section class="max-w-4xl mx-auto px-6 pt-20 pb-10 text-center">
    <h1 class="text-4xl md:text-5xl font-serif font-semibold">{about.heroH1}</h1>
    <p class="mt-4 text-stone-500">{about.heroSub}</p>
  </section>

  <section class="max-w-3xl mx-auto px-6 py-10">
    <p class="text-lg text-stone-700 leading-relaxed">{about.intro}</p>
  </section>

  <section class="bg-white border-y border-stone-100 py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-serif font-semibold mb-4 text-center">Our Process</h2>
      <p class="text-stone-600 max-w-2xl mx-auto text-center mb-2">{about.processIntro}</p>
      <p class="text-stone-600 max-w-2xl mx-auto text-center mb-10">{about.processIntro2}</p>
      <ol class="grid md:grid-cols-4 gap-6">
        {about.process.map((step, i) => (
          <li class="p-5 border border-stone-200 rounded-xl">
            <span class="text-rose-600 font-serif text-2xl font-bold">{i + 1}</span>
            <h3 class="font-semibold mt-2">{step.title}</h3>
            <p class="text-stone-600 text-sm mt-1">{step.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 py-16">
    <h2 class="text-2xl font-serif font-semibold mb-8 text-center">What We Do</h2>
    <div class="grid md:grid-cols-3 gap-8">
      {about.whatWeDo.map((item) => (
        <div class="p-6 border border-stone-200 rounded-xl">
          <h3 class="font-serif text-lg font-semibold mb-2">{item.title}</h3>
          <p class="text-stone-600 text-sm">{item.body}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="bg-stone-100 py-16">
    <div class="max-w-5xl mx-auto px-6">
      <h2 class="text-2xl font-serif font-semibold mb-8 text-center">Our Values</h2>
      <div class="grid md:grid-cols-5 gap-6">
        {about.values.map((v) => (
          <div class="text-center">
            <h3 class="font-semibold mb-2">{v.title}</h3>
            <p class="text-stone-600 text-sm">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-16 text-center">
    <h2 class="text-3xl font-serif font-semibold">{about.closingH2}</h2>
    <div class="mt-6 flex justify-center gap-4">
      <a href="/en/gallery/" class="border border-rose-600 text-rose-600 px-6 py-3 rounded-full font-semibold hover:bg-rose-50">{about.galleryCta}</a>
      <a href="/en/contact/" class="bg-rose-600 text-white px-6 py-3 rounded-full font-semibold hover:bg-rose-700">{about.contactCta}</a>
    </div>
  </section>
</Layout>
