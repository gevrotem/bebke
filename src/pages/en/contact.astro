---
import Layout from '../../layouts/Layout.astro';
import { contact, contactInfo } from '../../data/site.en';
---
<Layout lang="en" dir="ltr" title={contact.title} description={contact.description} canonical="https://bebke.com/en/contact/">
  <section class="bg-brand-red text-black px-6 py-20">
    <div class="max-w-5xl mx-auto text-center">
      <h1 class="text-4xl md:text-6xl font-black">Let's do something <span class="script font-normal">amazing</span> together.</h1>
      <p class="mt-4 font-bold text-lg max-w-xl mx-auto">{contact.formIntro}</p>
    </div>

    <div class="max-w-3xl mx-auto mt-14 grid md:grid-cols-2 gap-10">
      <div class="space-y-3 font-bold text-lg">
        <p>📞 {contactInfo.phoneTollFree}</p>
        <p>💬 WhatsApp: {contactInfo.whatsapp}</p>
        <p>🏢 Israel Office: {contactInfo.israelOffice}</p>
        <p>✉️ {contactInfo.email}</p>
        <div class="pt-4">
          <p class="text-sm font-bold uppercase tracking-wide mb-2">Follow us:</p>
          <div class="flex gap-5">
            <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="hover:opacity-70"><img src="/images/social/pinterest.webp" alt="Pinterest" class="h-6 w-auto" /></a>
            <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="hover:opacity-70"><img src="/images/social/facebook.webp" alt="Facebook" class="h-6 w-auto" /></a>
            <a href="https://vimeo.com" target="_blank" rel="noopener" aria-label="Vimeo" class="hover:opacity-70"><img src="/images/social/vimeo.webp" alt="Vimeo" class="h-6 w-auto" /></a>
            <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:opacity-70"><img src="/images/social/instagram.webp" alt="Instagram" class="h-6 w-auto" /></a>
          </div>
        </div>
      </div>

      <form class="space-y-4" x-data="{ sent: false }" @submit.prevent="sent = true">
        <input type="text" name="name" placeholder={contact.formFields.name} class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="email" name="email" placeholder={contact.formFields.email} class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" required />
        <input type="tel" name="phone" placeholder={contact.formFields.phone} class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" />
        <input type="text" name="date" placeholder={contact.formFields.date} class="w-full bg-transparent border-b-2 border-black py-2 font-medium placeholder-black/60 focus:outline-none" />
        <textarea name="message" placeholder={contact.formFields.message} rows="4" class="w-full bg-transparent border-2 border-black p-3 font-medium placeholder-black/60 focus:outline-none"></textarea>
        <button type="submit" class="bg-black text-brand-red px-8 py-3 font-bold rounded-full border-2 border-black hover:bg-white hover:text-black transition-colors" x-show="!sent">{contact.formFields.submit}</button>
        <p x-show="sent" x-cloak class="font-bold text-lg">Thank you! We'll be in touch shortly. 🎉</p>
      </form>
    </div>
  </section>

  <section class="bg-black text-white py-16 text-center px-6">
    <p class="text-lg font-medium">{contact.faqTeaser}</p>
    <a href="/en/blog/" class="inline-block mt-4 font-bold underline underline-offset-4">{contact.faqCta}</a>
  </section>
</Layout>
