---
import * as en from '../data/site.en';
import * as he from '../data/site.he';

interface Props { lang: 'en' | 'he' }
const { lang } = Astro.props;
const t = lang === 'he' ? he : en;
const base = `/${lang}`;
---
<footer class="bg-brand-red text-black mt-0">
  <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm font-medium">
    <p>{t.footer.rights}</p>
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-bold">
      <a href={`${base}/gallery/`} class="hover:underline">{t.nav.gallery}</a>
      <a href={`${base}/about/`} class="hover:underline">{t.nav.about}</a>
      <a href={`${base}/contact/`} class="hover:underline">{t.nav.contact}</a>
      <a href={`${base}/blog/`} class="hover:underline">{t.nav.blog}</a>
    </nav>
    <div class="flex items-center gap-4">
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:underline">Instagram</a>
      <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="hover:underline">Pinterest</a>
    </div>
  </div>
</footer>
