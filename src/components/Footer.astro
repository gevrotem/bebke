---
import * as en from '../data/site.en';
import * as he from '../data/site.he';

interface Props { lang: 'en' | 'he' }
const { lang } = Astro.props;
const t = lang === 'he' ? he : en;
const base = `/${lang}`;
---
<footer class="border-t border-stone-200 bg-white mt-16">
  <div class="max-w-6xl mx-auto px-6 py-10 flex flex-col md:flex-row items-center justify-between gap-4 text-sm text-stone-500">
    <p>{t.footer.rights}</p>
    <div class="flex items-center gap-6">
      <a href={`${base}/`} class="hover:text-rose-600">{t.footer.sitemap}</a>
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:text-rose-600">Instagram</a>
      <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="hover:text-rose-600">Pinterest</a>
    </div>
  </div>
</footer>
