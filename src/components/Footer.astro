---
import * as en from '../data/site.en';
import * as he from '../data/site.he';

interface Props { lang: 'en' | 'he' }
const { lang } = Astro.props;
const t = lang === 'he' ? he : en;
const base = `/${lang}`;
---
<div class="grid md:grid-cols-2">
  <a href={`${base}/contact/`} class="group relative bg-brand-blue text-white p-10 md:p-14 flex flex-col justify-center min-h-[220px] overflow-hidden">
    <svg class="w-10 h-10 mb-4 text-brand-yellow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <circle cx="12" cy="12" r="9" />
      <circle cx="12" cy="12" r="3.2" />
      <path d="M12 3v2.2M12 18.8V21M21 12h-2.2M5.2 12H3M18.4 5.6l-1.5 1.5M7.1 16.9l-1.5 1.5M18.4 18.4l-1.5-1.5M7.1 7.1l-1.5-1.5" />
    </svg>
    <h3 class="font-black text-2xl md:text-3xl">{t.footer.ctaSeenEnoughTitle}</h3>
    <p class="mt-2 text-white/80 font-medium">{t.footer.ctaSeenEnoughBody}</p>
    <span class="mt-6 inline-block font-bold underline underline-offset-4 group-hover:text-brand-yellow">{t.footer.ctaSeenEnoughCta}</span>
  </a>
  <a href={`${base}/about/`} class="group relative bg-brand-yellow text-black p-10 md:p-14 flex flex-col justify-center min-h-[220px] overflow-hidden">
    <h3 class="font-black text-2xl md:text-3xl">{t.footer.ctaWantMoreTitle}</h3>
    <p class="mt-2 font-medium opacity-80">{t.footer.ctaWantMoreBody}</p>
    <span class="mt-6 inline-block font-bold underline underline-offset-4 group-hover:text-brand-blue">{t.footer.ctaWantMoreCta}</span>
  </a>
</div>
<footer class="bg-brand-red text-black mt-0">
  <div class="max-w-6xl mx-auto px-6 py-8 flex flex-col md:flex-row items-center justify-between gap-4 text-sm font-medium">
    <p>{t.footer.rights}</p>
    <nav class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 font-bold">
      <a href={`${base}/gallery/`} class="hover:underline">{t.nav.gallery}</a>
      <a href={`${base}/about/`} class="hover:underline">{t.nav.about}</a>
      <a href={`${base}/contact/`} class="hover:underline">{t.nav.contact}</a>
      <a href={`${base}/blog/`} class="hover:underline">{t.nav.blog}</a>
      <a href="#" class="hover:underline" title="Coming soon">{t.nav.businessEvents}</a>
      <a href="#" class="hover:underline" title="Coming soon">{t.nav.creationLab}</a>
      <a href={`${base}/gallery/`} class="hover:underline">{t.nav.weddingTypes}</a>
    </nav>
    <div class="flex items-center gap-4 text-xl">
      <a href="https://pinterest.com" target="_blank" rel="noopener" aria-label="Pinterest" class="hover:opacity-70">
        <img src="/images/social/pinterest.webp" alt="Pinterest" class="h-5 w-auto" />
      </a>
      <a href="https://facebook.com" target="_blank" rel="noopener" aria-label="Facebook" class="hover:opacity-70">
        <img src="/images/social/facebook.webp" alt="Facebook" class="h-5 w-auto" />
      </a>
      <a href="https://vimeo.com" target="_blank" rel="noopener" aria-label="Vimeo" class="hover:opacity-70">
        <img src="/images/social/vimeo.webp" alt="Vimeo" class="h-5 w-auto" />
      </a>
      <a href="https://instagram.com" target="_blank" rel="noopener" aria-label="Instagram" class="hover:opacity-70">
        <img src="/images/social/instagram.webp" alt="Instagram" class="h-5 w-auto" />
      </a>
    </div>
  </div>
</footer>
