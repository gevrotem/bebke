---
import * as en from '../data/site.en';
import * as he from '../data/site.he';

interface Props { lang: 'en' | 'he' }
const { lang } = Astro.props;
const t = lang === 'he' ? he : en;
const base = `/${lang}`;
const path = new URL(Astro.request.url).pathname;
const isActive = (href: string) => path === href || path === href.replace(/\/$/, '');
// Swap the current path's language prefix so the toggle works on any domain
// (vercel.app preview, bebke.com, or bebke.co.il) without hardcoding a host.
const otherLang = lang === 'he' ? 'en' : 'he';
const langSwitchHref = path.replace(/^\/(en|he)/, `/${otherLang}`) || `/${otherLang}/`;
---
<header class="bg-brand-red text-black sticky top-0 z-50" x-data="{ menuOpen: false, weddingTypesOpen: false }">
  <div class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="tel:+972546696930" aria-label="Call Bebke" class="text-2xl leading-none">☎</a>
    <a href={`${base}/`} class="script text-3xl leading-none">bebke</a>

    <div class="flex items-center gap-4">
      <a href={langSwitchHref} class="text-sm font-bold border-2 border-black rounded-full px-3 py-1 hover:bg-black hover:text-brand-red transition-colors">{t.nav.langSwitchLabel}</a>
      <button @click="menuOpen = !menuOpen" aria-label="Open menu" class="h-9 w-9">
        <img src="/images/icons/menu-circle-closed.webp" alt="Menu" class="h-9 w-9" />
      </button>
    </div>
  </div>

  <!-- Full-screen circle-triggered overlay menu, matching Figma EN/HE 07_MENU frames -->
  <div x-show="menuOpen" x-cloak x-transition class="fixed inset-0 bg-brand-red z-50 flex flex-col">
    <div class="max-w-6xl w-full mx-auto px-6 py-5 flex items-center justify-between">
      <a href="tel:+972546696930" aria-label="Call Bebke" class="text-2xl leading-none">☎</a>
      <a href={`${base}/`} class="script text-3xl leading-none" @click="menuOpen = false">bebke</a>
      <button @click="menuOpen = false" aria-label="Close menu" class="text-2xl font-black h-9 w-9 flex items-center justify-center">✕</button>
    </div>

    <div class="flex-1 flex items-start justify-center gap-16 pt-6 md:pt-10 text-xl md:text-2xl font-bold">
      <div class="flex flex-col gap-5">
        <a href={`${base}/`} class:list={[isActive(`${base}/`) && "underline decoration-2 underline-offset-4"]} @click="menuOpen = false">{t.nav.home}</a>
        <a href={`${base}/gallery/`} class:list={[isActive(`${base}/gallery/`) && "underline decoration-2 underline-offset-4"]} @click="menuOpen = false">{t.nav.gallery}</a>
        <a href={`${base}/about/`} class:list={[isActive(`${base}/about/`) && "underline decoration-2 underline-offset-4"]} @click="menuOpen = false">{t.nav.about}</a>
        <a href={`${base}/contact/`} class:list={[isActive(`${base}/contact/`) && "underline decoration-2 underline-offset-4"]} @click="menuOpen = false">{t.nav.contact}</a>
      </div>
      <div class="flex flex-col gap-5">
        <a href={`${base}/blog/`} class:list={[isActive(`${base}/blog/`) && "underline decoration-2 underline-offset-4"]} @click="menuOpen = false">{t.nav.blog}</a>
        <button @click="weddingTypesOpen = !weddingTypesOpen" class="text-left underline decoration-2 underline-offset-4">{t.nav.weddingTypes}</button>
        <div x-show="weddingTypesOpen" x-cloak class="flex flex-col gap-2 text-sm md:text-base font-medium pl-1">
          {t.nav.weddingTypeLinks.map((item) => (
            <a href={`${base}${item.href}`} @click="menuOpen = false">{item.label}</a>
          ))}
        </div>
      </div>
    </div>

    <!-- Bottom photo strip, matching Figma's mosaic teaser row -->
    <div class="grid grid-cols-5 h-24 md:h-32">
      <div class="bg-brand-green"></div>
      <img src="/images/menu/thumb-1.webp" alt="" class="w-full h-full object-cover" />
      <img src="/images/menu/thumb-2.webp" alt="" class="w-full h-full object-cover" />
      <img src="/images/menu/thumb-3.webp" alt="" class="w-full h-full object-cover" />
      <img src="/images/menu/thumb-4.webp" alt="" class="w-full h-full object-cover" />
    </div>
  </div>
</header>
